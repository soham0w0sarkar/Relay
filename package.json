{
  "name": "Weavo",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "prettier": "^3.7.4",
    "turbo": "^2.8.7",
    "typescript": "5.9.2",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:pages": "bash scripts/build-pages.sh",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@weavo/core --filter=@weavo/sync --filter=@weavo/transport --filter=@weavo/client --filter=@weavo/membership && changeset publish",
    "tag-release": "bash scripts/tag-release.sh",
    "tag-demo": "bash scripts/tag-demo.sh",
    "tag-docs": "bash scripts/tag-docs.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "module": "index.ts",
  "type": "module"
}
